{
  "name": "research-voices-survey",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "PhD & Research Support survey on Firebase: Google sign-in, Firestore answers, admin results panel.",
  "scripts": {
    "build": "node scripts/build.js",
    "emulators": "firebase emulators:start --project demo-research-voices",
    "test": "firebase emulators:exec --project demo-research-voices --only firestore \"node --test tests/*.test.js\"",
    "deploy": "npm run build && firebase deploy --only hosting,firestore"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "esbuild": "^0.24.2",
    "firebase": "^11.1.0",
    "firebase-tools": "^13.29.1"
  }
}
