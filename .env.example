# Copy to .env and fill in.

# Google OAuth "Web application" Client ID (required for "Continue with Google").
# Create it at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=1234567890-xxxxxxxxxxxxxxxx.apps.googleusercontent.com

# Long random string used to sign login cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me

# Admin panel credentials
ADMIN_USERNAME=chinnu
ADMIN_PASSWORD=chinnu12345

# Where survey answers are stored (db.json). Use a persistent disk in production.
DATA_DIR=./data

PORT=3000
# NODE_ENV=production   # enables secure (HTTPS-only) cookies

# Local testing only: sign in by typing an email instead of Google.
# Ignored when NODE_ENV=production.
ALLOW_DEV_LOGIN=false
